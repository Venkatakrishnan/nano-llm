import torch
import torch.nn as nn
from model import MinimalLLM

# --- Hyperparameters ---
batch_size = 32      # Number of sequences processed in parallel
block_size = 64      # Maximum context length (number of tokens per sequence)
max_iters = 500      # Total training iterations
eval_interval = 100  # How often to check loss
learning_rate = 3e-4 # Standard learning rate for AdamW
hidden_dim = 256     # Hidden embedding dimension
num_layers = 4       # Number of transformer blocks
num_heads = 4        # Number of attention heads
use_rope = True      # Set to False to test NoPE (No Positional Encoding)

# --- Device Selection ---
if torch.cuda.is_available():
    device = torch.device("cuda")
    print("Using CUDA GPU (Windows/Linux)")
elif torch.backends.mps.is_available():
    device = torch.device("mps")
    print("Using MPS (Apple Silicon Mac M2/M2 Pro)")
else:
    device = torch.device("cpu")
    print("Using CPU")

# --- Data Loading (Tiny Sample Corpus) ---
# For a real run, you can point this to a text file like input.txt (e.g., TinyShakespeare)
text = """
The quick brown fox jumps over the lazy dog. 
A minimal language model trained from scratch using PyTorch tensors, 
attention mechanisms, and rotary position embeddings.
""" * 100

# Simple character-level tokenizer for demonstration
chars = sorted(list(set(text)))
vocab_size = len(chars)
stoi = {ch: i for i, ch in enumerate(chars)}
itos = {i: ch for i, ch in enumerate(chars)}

encode = lambda s: [stoi[c] for c in s]
decode = lambda l: "".join([itos[i] for i in l])

data = torch.tensor(encode(text), dtype=torch.long)
n = int(0.9 * len(data))
train_data = data[:n]
val_data = data[n:]

def get_batch(split):
    data_pool = train_data if split == 'train' else val_data
    # Generate random starting indices for batches
    ix = torch.randint(len(data_pool) - block_size, (batch_size,))
    x = torch.stack([data_pool[i:i+block_size] for i in ix])
    y = torch.stack([data_pool[i+1:i+block_size+1] for i in ix])
    return x.to(device), y.to(device)

# --- Model Initialization ---
model = MinimalLLM(
    vocab_size=vocab_size,
    hidden_dim=hidden_dim,
    num_layers=num_layers,
    num_heads=num_heads,
    use_rope=use_rope
).to(device)

print(f"Model initialized with {sum(p.numel() for p in model.parameters()) / 1e6:.2f}M parameters.")

# --- Optimizer ---
optimizer = torch.optim.AdamW(model.parameters(), lr=learning_rate)

# --- Training Loop ---
model.train()
for iter in range(max_iters):
    xb, yb = get_batch('train')
    
    # Forward pass
    logits, loss = model(xb, yb)
    
    # Backward pass & optimization
    optimizer.zero_grad(set_to_none=True)
    loss.backward()
    optimizer.step()
    
    if iter % eval_interval == 0 or iter == max_iters - 1:
        print(f"Step {iter:3d} | Training Loss: {loss.item():.4f}")

# --- Simple Generation Test ---
model.eval()
context = torch.tensor([encode("The")], dtype=torch.long, device=device).unsqueeze(0)
generated = context

with torch.no_grad():
    for _ in range(100):
        # Crop context to block_size if it gets too long
        idx_cond = generated[:, -block_size:]
        logits, _ = model(idx_cond)
        # Focus on the last time step
        logits = logits[:, -1, :] 
        probs = torch.softmax(logits, dim=-1)
        next_idx = torch.multinomial(probs, num_samples=1)
        generated = torch.cat((generated, next_idx), dim=1)

print("\n--- Generated Sample ---")
print(decode(generated[0].tolist()))
